rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. USERS COLLECTION (Public can get individual profile, only Admin can list)
    match /users/{userId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 1b. PRIVATE USER METADATA (Internal notes, stripe IDs)
    match /privateUserMetadata/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false; // Only admin SDK (Cloud Functions)
    }
    
    match /businessNames/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
    }

    // 2. STORE SETTINGS
    match /storeSettings/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 3. LISTINGS
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && resource.data.sellerId == request.auth.uid;
    }
    
    // 4. LEADS (Allows Guest Access for Creation)
    match /leads/{leadId} {
      // Dealers can read their own received leads
      allow read: if request.auth != null && (request.auth.uid == resource.data.dealerId || request.auth.token.admin == true);
     
      allow create: if 
        // If logged in, enforce UID match. If guest, allow.
        (request.auth != null ? request.resource.data.buyerUid == request.auth.uid : true)
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId
            == request.resource.data.dealerId;
     
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.dealerId || 
        request.auth.uid == resource.data.buyerUid || 
        request.auth.token.admin == true
      );
    }

    // 5. STORE REVIEWS
    match /storeReviews/{reviewId} {
      allow read: if true;
     
      allow create, update: if request.auth != null
        && reviewId == (request.resource.data.storeUid + "_" + request.auth.uid)
        && request.resource.data.reviewerUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "individual"
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
     
      allow delete: if request.auth != null && (
        resource.data.reviewerUid == request.auth.uid || 
        resource.data.storeUid == request.auth.uid ||
        request.auth.token.admin == true
      );
    }
  }
}
