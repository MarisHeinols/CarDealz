rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1a. PUBLIC USER PROFILES (Public storefront-safe fields only)
    match /publicUsers/{userId} {
      allow get, list: if true;
      allow create, update, delete: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
    }

    // 1b. PRIVATE USER PROFILES (PII, contact details, billing)
    match /privateUsers/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
    }

    // 1c. LEGACY USERS COLLECTION (kept for migration only; never public)
    match /users/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.admin == true
      );
    }

    // 1b. PRIVATE USER METADATA (Internal notes, stripe IDs)
    match /privateUserMetadata/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false; // Only admin SDK (Cloud Functions)
    }
    
    match /businessNames/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
    }

    // 2. STORE SETTINGS
    match /storeSettings/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 3. LISTINGS
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && resource.data.sellerId == request.auth.uid;
    }
    
    // 4. LEADS (Allows Guest Access for Creation)
    match /leads/{leadId} {
      // Dealers can read their own received leads
      allow read: if request.auth != null && (request.auth.uid == resource.data.dealerId || request.auth.token.admin == true);
     
      // Lead creation is only allowed via server-side logic (Cloud Functions / Admin SDK).
      allow create: if false;
     
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.dealerId || 
        request.auth.uid == resource.data.buyerUid || 
        request.auth.token.admin == true
      );
    }

    // 5. STORE REVIEWS
    match /storeReviews/{reviewId} {
      allow read, create, update, delete: if false;
    }
  }
}
